{
  "name": "coy-discover",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "seed": "npm run seed -w apps/api",
    "db": "node scripts/db.mjs",
    "keepalive": "node scripts/ping-render.mjs",
    "format": "prettier --write .github apps scripts README.md docs/*.md *.json",
    "format:check": "prettier --check .github apps scripts README.md docs/*.md *.json"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
